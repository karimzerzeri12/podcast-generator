# Python
backend/.venv/
**/__pycache__/
**/*.pyc
backend/storage/

# Node / frontend build
frontend/node_modules/
frontend/dist/

# Local env / secrets — never bake them into the image (injected at runtime instead)
.env
.env.production
frontend/.env.local

# Persistent data volume (VM deploy) — must never be copied into the image
data/

# Misc
.git/
*.md
