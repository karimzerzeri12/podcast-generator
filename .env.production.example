# Copy to .env.production on the server and fill in real values.
# docker-compose.yml reads this file and injects these as the container's environment.
# Do NOT commit .env.production — it holds real secrets (it's gitignored/dockerignored).
#
# You do NOT need to set DATABASE_URL / CHROMA_DIR / SCRIPTS_DIR / AUDIO_DIR here — the
# Dockerfile already points them at /app/storage, which is mounted to the persistent
# ./data volume by docker-compose.

# --- Secrets ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
GEMINI_API_KEY=your-gemini-api-key
# Long random strings. SESSION_SECRET signs student tokens; ADMIN_TOKEN is your admin login.
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_TOKEN=replace-with-a-long-random-string

# --- Config ---
# Comma-separated ElevenLabs voice IDs from YOUR account.
ELEVENLABS_VOICE_IDS=voice_id_1,voice_id_2,voice_id_3
GEMINI_MODEL=gemini-flash-latest
# The URL students will use. Same-origin requests work regardless, but set this to your
# server's address for correctness. Must NOT be "*". Examples:
#   http://123.45.67.89        (accessing by public IP over HTTP)
#   https://podcasts.example.com   (if you add a domain + TLS)
CORS_ORIGINS=http://YOUR_SERVER_IP
